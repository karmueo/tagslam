Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.35
      Cell Size: 0.25
      Color: 130; 130; 135
      Line Style:
        Line Width: 0.01
        Value: Lines
      Plane: XY
      Plane Cell Count: 16
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Segmented trajectory
      Enabled: true
      Namespaces:
        tagslam_trajectory: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /tagslam/trajectory/body_rig
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Pose samples
      Enabled: false
      Keep: 4000
      Position Tolerance: 0
      Angle Tolerance: 0
      Covariance:
        Value: false
        Position:
          Value: false
        Orientation:
          Value: false
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 40; 220; 255
        Shaft Length: 0.015
        Shaft Radius: 0.002
        Head Length: 0.006
        Head Radius: 0.003
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /tagslam/odom/body_rig
      Value: false
    - Class: rviz_default_plugins/TF
      Name: Tag and rig frames
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        map:
          Value: false
        environment:
          Value: false
        o_tag_0:
          Value: false
        cam0:
          Value: false
        cam1:
          Value: false
        rig:
          Value: true
        tag_0:
          Value: true
        tag_1:
          Value: true
        tag_2:
          Value: true
        tag_3:
          Value: true
        tag_4:
          Value: true
        tag_5:
          Value: true
        tag_6:
          Value: true
      Marker Scale: 0.7
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.6
      Focal Point:
        X: -0.35
        Y: -0.15
        Z: 0.9
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Time:
    collapsed: false
  Width: 1440
